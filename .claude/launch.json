      "port": 4177
    },
    {
      "name": "front-static-wws2",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4178", "--directory", "front"],
      "port": 4178
    },
    {
      "name": "front-static-neon",
      "runtimeExecutable": "python3",
