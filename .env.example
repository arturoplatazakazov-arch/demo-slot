APP_NAME=demo-slot
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://demo_slot:demo_slot@localhost:5432/demo_slot
DATABASE_URL_SYNC=postgresql+psycopg://demo_slot:demo_slot@localhost:5432/demo_slot

DEFAULT_CURRENCY=FUN
DEFAULT_STARTING_BALANCE=1000000

# Comma-separated explicit origins allowed for CORS, e.g. https://app.example.com
CORS_ALLOW_ORIGINS=
# Regex fallback — defaults to "any localhost port", good enough for local dev
# where the front/ static server runs on its own port.
CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$
