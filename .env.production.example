# Production / embed profile — SQLite single-container setup (Railway, etc.).
# Copy these into the host's environment variables (Railway → Variables).
# Nothing here changes local dev: without these vars the app keeps its
# Postgres defaults from app/core/config.py.

APP_NAME=demo-slot
ENVIRONMENT=production
DEBUG=false

# SQLite lives on a persistent volume so the schema survives redeploys.
# Mount a Railway Volume at /data, then use an ABSOLUTE path (4 slashes).
# Async URL for the app, sync URL for Alembic migrations — same file.
DATABASE_URL=sqlite+aiosqlite:////data/demo.db
DATABASE_URL_SYNC=sqlite:////data/demo.db

DEFAULT_CURRENCY=FUN
DEFAULT_STARTING_BALANCE=1000000

# Only the real site origin may call the API. No trailing slash.
# GitHub Pages project site: https://<user>.github.io
# GitHub Pages user/org site or custom domain: set that instead.
CORS_ALLOW_ORIGINS=https://YOUR_GH_USERNAME.github.io
# No localhost regex in production — lock CORS down to the origins above.
CORS_ALLOW_ORIGIN_REGEX=
